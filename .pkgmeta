package-as: WeaponJourney

# The repo is still named TitanWeaponSkills (the CurseForge project id 1309370
# is tied to it); the shipped addon folder is WeaponJourney. Without package-as
# the packager would name the folder after the repo and the .toc/Media paths
# ("Interface\AddOns\WeaponJourney\...") would break in the packaged build.
